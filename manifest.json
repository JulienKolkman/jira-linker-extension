{
  "manifest_version": 3,
  "name": "GitHub PR to Jira Linker",
  "version": "1.1",
  "description": "Automatically hyperlinks Jira issue keys in GitHub PR titles.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}